# LLM
ANTHROPIC_API_KEY=

# Avalanche C-Chain
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# 43114 = C-Chain mainnet (required for hackathon submission)
# 43113 = Fuji testnet (required by the sandbox card-issuance MCP tool)
AVALANCHE_CHAIN_ID=43114
WALLET_PRIVATE_KEY=
XSGD_CONTRACT_ADDRESS=

# StraitsX -- pick a backend with STRAITSX_MODE: mock | mcp | rest
STRAITSX_MODE=mock

# mcp mode (recommended if you don't have a StraitsX business account --
# the sandbox MCP server handles StraitsX-side auth for you)
STRAITSX_MCP_SANDBOX_URL=https://card.straitsx.ai/sandbox/sse
STRAITSX_MCP_PRODUCTION_URL=https://card.straitsx.ai/production/sse
STRAITSX_MCP_ENV=sandbox

# rest mode (requires business-account API credentials)
STRAITSX_API_BASE=https://api.straitsx.com
STRAITSX_API_KEY=
STRAITSX_API_SECRET=

# Spending policy
MAX_TRANSACTION_SGD=50
DAILY_LIMIT_SGD=200
ALLOWED_MERCHANT_DOMAINS=localhost,demo-shop.test

# Checkout
CHECKOUT_HEADLESS=true
